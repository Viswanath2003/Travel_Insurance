// ============================================================
// Travel Insurance Platform — Complete ER Diagram (DBML)
// Tool: https://dbdiagram.io  — paste this entire file
// Crow's Foot notation rendered automatically
// 25 tables across 11 schemas (V02–V12 PostgreSQL DDL)
// ============================================================

// ─── ins_auth ─────────────────────────────────────────────

Table ins_auth.roles {
  id              uuid        [pk, default: `gen_random_uuid()`]
  role_code       varchar(50) [unique, not null, note: "ROLE_CUSTOMER | ROLE_AGENT | ROLE_UNDERWRITER | ROLE_CLAIMS_OFFICER | ROLE_FIELD_OFFICER | ROLE_FINANCE | ROLE_RELATIONSHIP_MANAGER"]
  role_name       varchar(100)[not null]
  portal_path     varchar(200)[note: "Relative path to portal served for this role"]
  description     text
  is_active       boolean     [not null, default: true]
  created_at      timestamptz [not null, default: `now()`]
  updated_at      timestamptz [not null, default: `now()`]
}

Table ins_auth.users {
  id                        uuid        [pk, default: `gen_random_uuid()`]
  email                     varchar(150)[unique, not null]
  full_name                 varchar(120)[not null]
  password_hash             varchar(255)[not null]
  role                      varchar(50) [not null, ref: > ins_auth.roles.role_code, note: "Single role column — no M:M role tables"]
  status                    varchar(30) [not null, default: "ACTIVE", note: "ACTIVE | INACTIVE | LOCKED"]
  failed_login_attempts     smallint    [not null, default: 0]
  locked_until              timestamptz
  last_login_at             timestamptz
  profile_photo_path        varchar(500)
  // Customer PII (NULL for all non-ROLE_CUSTOMER users)
  mobile                    varchar(20)
  customer_type             varchar(20) [note: "INDIVIDUAL | CORPORATE"]
  date_of_birth             date
  gender                    varchar(25) [note: "MALE | FEMALE | OTHER | PREFER_NOT_TO_SAY"]
  nationality               char(2)     [note: "ISO 3166-1 alpha-2"]
  passport_number           varchar(20)
  passport_expiry_date      date
  address_line1             varchar(200)
  address_line2             varchar(200)
  city                      varchar(100)
  state_province            varchar(100)
  postal_code               varchar(20)
  country_code              char(2)
  emergency_contact_name    varchar(100)
  emergency_contact_phone   varchar(20)
  occupation                varchar(100)
  annual_income_band        varchar(30) [note: "BELOW_300K | 300K_TO_1M | 1M_TO_3M | ABOVE_3M"]
  pending_profile_changes   jsonb       [note: "Awaits underwriter approval: [{field, old_value, new_value}]"]
  created_at                timestamptz [not null, default: `now()`]
  updated_at                timestamptz [not null, default: `now()`]
  created_by                uuid        [note: "Agent UUID if agent-created customer"]
  version                   bigint      [not null, default: 0]
}

Table ins_auth.user_sessions {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  user_id             uuid        [not null, ref: > ins_auth.users.id]
  refresh_token_hash  varchar(255)[not null, note: "SHA-256 of refresh token — never store raw"]
  device_info         varchar(500)
  ip_address          varchar(45) [note: "Supports IPv6"]
  issued_at           timestamptz [not null, default: `now()`]
  expires_at          timestamptz [not null]
  revoked_at          timestamptz
  is_revoked          boolean     [not null, default: false]
}

// ─── ins_product ──────────────────────────────────────────

Table ins_product.insurance_products {
  id                uuid        [pk, default: `gen_random_uuid()`]
  product_code      varchar(50) [unique, not null]
  product_name      varchar(150)[not null]
  type_code         varchar(50) [not null, note: "SINGLE_TRIP | ANNUAL_MULTI_TRIP | STUDENT | FAMILY | CORPORATE | SENIOR_CITIZEN | GROUP"]
  description       text
  is_active         boolean     [not null, default: true]
  launch_date       date
  discontinue_date  date
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  created_by        uuid
}

Table ins_product.plans {
  id                          uuid          [pk, default: `gen_random_uuid()`]
  plan_code                   varchar(50)   [unique, not null]
  plan_name                   varchar(150)  [not null]
  product_id                  uuid          [not null, ref: > ins_product.insurance_products.id]
  base_premium                decimal(12,2) [not null]
  daily_rate                  decimal(10,4) [not null, default: 0]
  currency                    char(3)       [not null, default: "INR"]
  min_trip_days               int           [not null, default: 1]
  max_trip_days               int           [not null, default: 365]
  min_traveler_age            int           [not null, default: 0]
  max_traveler_age            int           [not null, default: 99]
  max_travelers               int           [not null, default: 10]
  zone_codes                  "text[]"      [not null, default: "'{}'", note: "Zone identifiers: {ZONE_DOMESTIC, ZONE_SE_ASIA, ...}"]
  premium_breakdown_config    jsonb         [note: "{gst_rate, online_discount, trip_multipliers, zone_loadings}"]
  status                      varchar(20)   [not null, default: "DRAFT", note: "DRAFT | ACTIVE | INACTIVE | DISCONTINUED"]
  version                     int           [not null, default: 1]
  published_at                timestamptz
  published_by                uuid
  created_at                  timestamptz   [not null, default: `now()`]
  updated_at                  timestamptz   [not null, default: `now()`]
  created_by                  uuid
}

Table ins_product.plan_coverages {
  id                uuid          [pk, default: `gen_random_uuid()`]
  plan_id           uuid          [not null, ref: > ins_product.plans.id]
  coverage_code     varchar(50)   [not null, note: "EMERGENCY_MEDICAL | TRIP_CANCELLATION | BAGGAGE_LOSS | ..."]
  coverage_name     varchar(150)  [not null]
  coverage_category varchar(50)   [note: "HEALTH | TRAVEL | FINANCIAL | PERSONAL | ADVENTURE"]
  min_limit         decimal(15,2) [not null, default: 0]
  max_limit         decimal(15,2) [not null]
  default_limit     decimal(15,2) [not null]
  limit_step        decimal(15,2) [not null, default: 1000]
  currency          char(3)       [not null, default: "INR"]
  deductible        decimal(12,2) [not null, default: 0]
  is_mandatory      boolean       [not null, default: false]
  is_adjustable     boolean       [not null, default: false, note: "TRUE = customer can slide coverage limit"]
  is_active         boolean       [not null, default: true]
  sort_order        int           [not null, default: 0]

  indexes {
    (plan_id, coverage_code) [unique]
  }
}

Table ins_product.addons {
  id                    uuid          [pk, default: `gen_random_uuid()`]
  addon_code            varchar(50)   [unique, not null]
  addon_name            varchar(150)  [not null]
  addon_category        varchar(50)   [note: "MEDICAL | TRAVEL | FINANCIAL | ADVENTURE | PERSONAL | CORPORATE"]
  description           text
  pricing_type          varchar(20)   [not null, note: "FLAT | PERCENT_OF_BASE | PER_DAY | PER_TRAVELER"]
  pricing_value         decimal(12,4) [not null]
  currency              char(3)       [not null, default: "INR"]
  compatible_plan_codes "text[]"      [not null, default: "'{}'", note: "{} = all plans; {BASIC,PLUS} = restricted"]
  is_active             boolean       [not null, default: true]
  sort_order            int           [not null, default: 0]
  created_at            timestamptz   [not null, default: `now()`]
  updated_at            timestamptz   [not null, default: `now()`]
  created_by            uuid
}

// ─── ins_rule ─────────────────────────────────────────────

Table ins_rule.rule_definitions {
  id                uuid        [pk, default: `gen_random_uuid()`]
  rule_code         varchar(100)[not null]
  rule_name         varchar(200)[not null]
  rule_type         varchar(30) [not null, note: "RISK_SCORING | PREMIUM_LOADING | DISCOUNT | ELIGIBILITY | ROUTING | CLAIMS_AUTO_DECISION"]
  description       text
  priority          int         [not null, default: 100, note: "Lower = evaluated first"]
  status            varchar(20) [not null, default: "DRAFT", note: "DRAFT | PUBLISHED | SUPERSEDED | INACTIVE"]
  is_active         boolean     [not null, default: true]
  stop_on_match     boolean     [not null, default: false]
  logical_operator  varchar(5)  [not null, default: "AND", note: "AND | OR — how condition groups combine"]
  actions_config    jsonb       [not null, default: "[]", note: "[{action_type, value, description}] — absorbs old rule_actions table"]
  version           int         [not null, default: 1]
  published_at      timestamptz
  published_by      uuid
  effective_from    date
  effective_to      date
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]
  created_by        uuid

  indexes {
    (rule_code, version) [unique]
  }
}

Table ins_rule.rule_conditions {
  id              uuid        [pk, default: `gen_random_uuid()`]
  rule_id         uuid        [not null, ref: > ins_rule.rule_definitions.id]
  group_number    int         [not null, default: 1, note: "Conditions with same group_number form one condition group"]
  group_operator  varchar(5)  [not null, default: "AND", note: "AND | OR — how conditions in this group combine"]
  field_name      varchar(200)[not null, note: "Dot-notation: traveler.age_group | trip.duration_days | claim.amount"]
  operator        varchar(15) [not null, note: "EQ | NEQ | GT | GTE | LT | LTE | IN | NOT_IN | BETWEEN | IS_NULL | IS_NOT_NULL | CONTAINS"]
  field_value     varchar(500)[note: "Primary comparison value"]
  field_value2    varchar(500)[note: "Upper bound for BETWEEN operator"]
  value_list      text        [note: "Comma-separated list for IN / NOT_IN operators"]
  sort_order      int         [not null, default: 0]
}

// ─── ins_policy ───────────────────────────────────────────

Table ins_policy.quotes {
  id                          uuid          [pk, default: `gen_random_uuid()`]
  quote_reference             varchar(30)   [unique, not null]
  customer_id                 uuid          [not null, note: "ins_auth.users.id — no FK (cross-schema)"]
  product_id                  uuid          [not null, note: "ins_product.insurance_products.id — no FK"]
  plan_id                     uuid          [not null, note: "ins_product.plans.id — no FK"]
  plan_code                   varchar(50)   [not null, note: "Denormalized for display"]
  destination_country_code    char(2)       [not null]
  destination_zone_code       varchar(30)
  trip_start_date             date          [not null]
  trip_end_date               date          [not null]
  trip_duration_days          int           [not null]
  num_travelers               int           [not null, default: 1]
  trip_purpose                varchar(30)   [not null, default: "LEISURE", note: "LEISURE | BUSINESS | EDUCATION | MEDICAL | PILGRIMAGE | ADVENTURE"]
  total_premium               decimal(12,2)
  currency                    char(3)       [not null, default: "INR"]
  risk_score                  "numeric(5,2)"[note: "Internal — hidden from customer"]
  risk_level                  varchar(12)   [note: "LOW | MEDIUM | HIGH | VERY_HIGH — internal"]
  premium_breakdown           jsonb         [note: "{base_premium, zone_loading, risk_loading, ..., gross_premium, net_premium}"]
  selections_json             jsonb         [note: "{coverages:[{code,name,selected_limit,premium}], addons:[...]}"]
  status                      varchar(20)   [not null, default: "DRAFT", note: "DRAFT | CALCULATED | EXPIRED | CONVERTED | ABANDONED"]
  agent_id                    uuid
  expires_at                  timestamptz   [not null]
  created_at                  timestamptz   [not null, default: `now()`]
  updated_at                  timestamptz   [not null, default: `now()`]
  created_by                  uuid
}

Table ins_policy.travelers {
  id                        uuid        [pk, default: `gen_random_uuid()`]
  context_type              varchar(10) [not null, note: "QUOTE | POLICY"]
  context_id                uuid        [not null, note: "quotes.id or policies.id"]
  traveler_sequence         int         [not null, note: "1 = primary traveler"]
  full_name                 varchar(120)
  date_of_birth             date        [not null]
  age                       int         [not null]
  age_band                  varchar(25) [note: "CHILD_0_17 | ADULT_18_35 | ADULT_36_59 | SENIOR_60_70 | SENIOR_71_PLUS"]
  passport_number           varchar(20)
  nationality               char(2)
  gender                    varchar(25)
  contact_number            varchar(20)
  is_primary                boolean     [not null, default: false]
  has_preexisting_condition boolean     [not null, default: false]
  has_adventure_activity    boolean     [not null, default: false]
  individual_risk_score     "numeric(5,2)" [note: "Internal — hidden from customer"]
  individual_premium        decimal(10,2)
  nominee_name              varchar(100)
  nominee_relationship      varchar(50)

  indexes {
    (context_type, context_id, traveler_sequence) [unique]
  }
}

Table ins_policy.policies {
  id                          uuid          [pk, default: `gen_random_uuid()`]
  policy_number               varchar(30)   [unique, not null]
  quote_id                    uuid          [not null, ref: > ins_policy.quotes.id]
  customer_id                 uuid          [not null, note: "ins_auth.users.id — no FK (cross-schema)"]
  product_id                  uuid          [not null]
  plan_id                     uuid          [not null]
  plan_code                   varchar(50)   [not null]
  destination_country_code    char(2)       [not null]
  destination_zone_code       varchar(30)
  trip_start_date             date          [not null]
  trip_end_date               date          [not null]
  trip_duration_days          int           [not null]
  num_travelers               int           [not null, default: 1]
  trip_purpose                varchar(30)
  total_premium               decimal(12,2) [not null]
  currency                    char(3)       [not null, default: "INR"]
  risk_score                  "numeric(5,2)"[note: "Internal — hidden from customer"]
  risk_level                  varchar(12)   [note: "LOW | MEDIUM | HIGH | VERY_HIGH — internal"]
  status                      varchar(30)   [not null, note: "PENDING_PAYMENT | PENDING_REVIEW | PENDING_UW | UNDER_REVIEW | ACTIVE | EXPIRED | CANCELLED | CANCELLATION_REQUESTED | REJECTED | LAPSED"]
  coverage_details            jsonb         [note: "Locked at issuance: {coverages:[...], addons:[...]}"]
  premium_breakdown           jsonb         [note: "Locked at issuance"]
  issue_date                  timestamptz
  expiry_date                 date
  cancellation_date           timestamptz
  cancellation_reason         text
  parent_policy_id            uuid          [ref: > ins_policy.policies.id, note: "For renewals"]
  renewal_count               int           [not null, default: 0]
  payment_reference           varchar(100)
  payment_recorded_at         timestamptz
  created_at                  timestamptz   [not null, default: `now()`]
  updated_at                  timestamptz   [not null, default: `now()`]
  created_by                  uuid
  version                     bigint        [not null, default: 0]
}

Table ins_policy.policy_snapshots {
  id                uuid        [pk, default: `gen_random_uuid()`]
  policy_id         uuid        [not null, ref: > ins_policy.policies.id]
  snapshot_version  int         [not null, default: 1]
  snapshot_type     varchar(20) [not null, note: "ISSUANCE | ENDORSEMENT | RENEWAL | CANCELLATION"]
  snapshot_data     jsonb       [not null, note: "Full policy state: coverage_details, travelers, premium_breakdown, rule versions"]
  snapshotted_at    timestamptz [not null, default: `now()`]
  snapshotted_by    uuid

  indexes {
    (policy_id, snapshot_version) [unique]
  }

  Note: "Immutable — no updates allowed. Claims always read coverage terms from here."
}

Table ins_policy.policy_agent_bindings {
  id                  uuid          [pk, default: `gen_random_uuid()`]
  policy_id           uuid          [unique, not null, ref: > ins_policy.policies.id]
  agent_user_id       uuid          [not null, note: "ins_auth.users.id — no FK (cross-schema)"]
  agent_code          varchar(50)   [not null, note: "Denormalized for commission reporting"]
  bound_at            timestamptz   [not null, default: `now()`]
  commission_rate     "numeric(5,2)"[not null, note: "Percentage locked at binding time"]
  net_premium         decimal(12,2) [not null]
  commission_amount   decimal(12,2) [not null, note: "= net_premium × commission_rate / 100"]
  currency            char(3)       [not null, default: "INR"]
  commission_status   varchar(20)   [not null, default: "PENDING", note: "PENDING | APPROVED | PAID | CANCELLED"]
  approved_by         uuid
  approved_at         timestamptz
  paid_at             timestamptz
  payment_reference   varchar(100)
  notes               text
  created_at          timestamptz   [not null, default: `now()`]
  updated_at          timestamptz   [not null, default: `now()`]
}

// ─── ins_uw ───────────────────────────────────────────────

Table ins_uw.uw_cases {
  id                uuid          [pk, default: `gen_random_uuid()`]
  case_reference    varchar(30)   [unique, not null]
  policy_id         uuid          [unique, not null, note: "ins_policy.policies.id — no FK (cross-schema)"]
  policy_number     varchar(30)   [not null, note: "Denormalized for display"]
  customer_id       uuid          [not null]
  risk_score        "numeric(5,2)"[note: "Internal — hidden from customer"]
  risk_level        varchar(12)   [note: "LOW | MEDIUM | HIGH | VERY_HIGH — internal"]
  forward_reason    text          [note: "Why policy was forwarded to UW review"]
  status            varchar(30)   [not null, default: "OPEN", note: "OPEN | IN_REVIEW | APPROVED | REJECTED | FORWARDED_TO_FIELD | CLOSED"]
  assigned_to       uuid          [note: "ins_auth.users.id of assigned underwriter"]
  assigned_at       timestamptz
  decision          varchar(30)   [note: "APPROVED | REJECTED | FORWARDED_TO_FIELD"]
  decision_reason   text
  decided_at        timestamptz
  decided_by        uuid
  sla_due_at        timestamptz
  created_at        timestamptz   [not null, default: `now()`]
  updated_at        timestamptz   [not null, default: `now()`]
}

Table ins_uw.uw_events {
  id            bigint      [pk, increment, note: "GENERATED ALWAYS AS IDENTITY"]
  case_id       uuid        [not null, ref: > ins_uw.uw_cases.id]
  event_type    varchar(20) [not null, note: "STATUS_CHANGED | NOTE | DOCUMENT_REQ | DECISION | FORWARDED | ASSIGNED"]
  from_status   varchar(30)
  to_status     varchar(30)
  event_data    jsonb       [note: "Type-specific payload: {from,to} | {note} | {decision,reason} | {field_officer_id,reason}"]
  performed_by  uuid
  performed_at  timestamptz [not null, default: `now()`]
}

// ─── ins_claims ───────────────────────────────────────────

Table ins_claims.claims {
  id                          uuid          [pk, default: `gen_random_uuid()`]
  claim_reference             varchar(30)   [unique, not null]
  policy_id                   uuid          [not null, note: "ins_policy.policies.id — no FK (cross-schema)"]
  policy_number               varchar(30)   [not null, note: "Denormalized for display"]
  policy_snapshot_id          uuid          [not null, note: "ins_policy.policy_snapshots.id — coverage terms always from snapshot"]
  customer_id                 uuid          [not null]
  claim_type_code             varchar(80)   [not null, note: "MEDICAL | BAGGAGE_LOSS | TRIP_CANCELLATION | FLIGHT_DELAY | PERSONAL_LIABILITY | PASSPORT_LOSS | EMERGENCY_EVACUATION | DENTAL | ACCIDENTAL_DEATH | OTHER"]
  status                      varchar(40)   [not null, default: "SUBMITTED", note: "SUBMITTED | DOCUMENT_REVIEW | DOCUMENT_PENDING | UNDER_REVIEW | INVESTIGATION_ASSIGNED | INVESTIGATION_COMPLETE | DECISION_PENDING | AUTO_APPROVED | AUTO_DECLINED | APPROVED | PARTIALLY_APPROVED | DECLINED | PAYMENT_PENDING | SETTLED | CLOSED"]
  incident_date               date          [not null]
  incident_description        text
  claimed_amount              decimal(12,2) [not null]
  approved_amount             decimal(12,2)
  currency                    char(3)       [not null, default: "INR"]
  claimant_info               jsonb         [note: "[{traveler_name, age_group, is_primary_claimant}]"]
  assigned_officer_id         uuid
  sla_due_at                  timestamptz
  sla_breached                boolean       [not null, default: false]
  decision_reason             text
  decided_at                  timestamptz
  decided_by                  uuid
  payment_reference           varchar(60)
  payment_method              varchar(30)
  paid_at                     timestamptz
  is_high_value               boolean       [not null, default: false, note: "TRUE when claimed_amount > platform_configurations claims.high_value_threshold"]
  field_investigation_required boolean      [not null, default: false]
  priority                    varchar(10)   [not null, default: "MEDIUM", note: "LOW | MEDIUM | HIGH | CRITICAL"]
  metadata                    jsonb
  created_at                  timestamptz   [not null, default: `now()`]
  updated_at                  timestamptz   [not null, default: `now()`]
  version                     bigint        [not null, default: 0]
}

Table ins_claims.claim_documents {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  claim_id            uuid        [not null, ref: > ins_claims.claims.id]
  document_type_code  varchar(60) [not null, note: "HOSPITAL_BILL | POLICE_FIR | BOARDING_PASS | PASSPORT_COPY | ..."]
  document_name       varchar(200)[not null]
  storage_key         varchar(500)[not null, note: "S3/MinIO object key"]
  file_size_bytes     bigint
  mime_type           varchar(100)
  uploaded_by         uuid        [not null]
  is_verified         boolean     [not null, default: false]
  verified_by         uuid
  verified_at         timestamptz
  created_at          timestamptz [not null, default: `now()`]
}

Table ins_claims.claim_events {
  id            bigint      [pk, increment, note: "GENERATED ALWAYS AS IDENTITY"]
  claim_id      uuid        [not null, ref: > ins_claims.claims.id]
  event_type    varchar(20) [not null, note: "STATUS_CHANGED | NOTE | DECISION | PAYMENT | DOCUMENT_REVIEW | FIELD_FORWARDED | ASSIGNED"]
  from_status   varchar(40)
  to_status     varchar(40)
  event_data    jsonb       [note: "TYPE-specific: {from,to} | {note,is_internal} | {decision,amount,reason} | {amount,payment_reference,method}"]
  performed_by  uuid
  performed_at  timestamptz [not null, default: `now()`]
}

// ─── ins_field ────────────────────────────────────────────

Table ins_field.field_investigations {
  id                          uuid        [pk, default: `gen_random_uuid()`]
  investigation_reference     varchar(30) [unique, not null, note: "e.g. FI20250520001"]
  claim_id                    uuid        [not null, note: "ins_claims.claims.id — no FK (cross-schema)"]
  claim_reference             varchar(30) [not null, note: "Denormalized for display"]
  assigned_officer_id         uuid        [not null]
  assigned_officer_name       varchar(120)
  assigned_by                 uuid        [not null, note: "Claims officer who created the investigation"]
  status                      varchar(30) [not null, default: "ASSIGNED", note: "ASSIGNED | IN_PROGRESS | REPORT_SUBMITTED | COMPLETED | CANCELLED"]
  priority                    varchar(10) [not null, default: "MEDIUM", note: "LOW | MEDIUM | HIGH"]
  investigation_type          varchar(60) [note: "MEDICAL_VERIFICATION | BAGGAGE_LOSS | PROPERTY_DAMAGE | ACCIDENT_VERIFICATION | OTHER"]
  investigation_location      varchar(300)
  notes_for_officer           text
  due_at                      timestamptz [not null]
  sla_breached                boolean     [not null, default: false]
  // Report fields (populated by Field Officer on submission)
  inspection_date             date
  location_visited            varchar(300)
  claimant_present            boolean
  findings                    text
  recommendation              varchar(40) [note: "APPROVE | PARTIAL_APPROVE | REJECT | FURTHER_INVESTIGATION_NEEDED"]
  recommendation_notes        text
  report_submitted_at         timestamptz
  // Review fields (populated by Claims Officer after report)
  review_outcome              varchar(20) [note: "ACCEPTED | REJECTED | NEEDS_REWORK"]
  reviewed_by                 uuid
  reviewed_at                 timestamptz
  // Evidence
  evidence_docs               jsonb       [not null, default: "[]", note: "[{document_type, document_name, storage_key, caption, uploaded_by, created_at}]"]
  created_at                  timestamptz [not null, default: `now()`]
  updated_at                  timestamptz [not null, default: `now()`]
}

// ─── ins_document ─────────────────────────────────────────

Table ins_document.document_templates {
  id                      uuid        [pk, default: `gen_random_uuid()`]
  template_code           varchar(80) [unique, not null]
  template_name           varchar(150)[not null]
  document_category       varchar(40) [not null, note: "POLICY | CLAIM | FINANCE | SYSTEM"]
  description             text
  current_version_number  int         [not null, default: 1]
  current_content         text        [note: "Active Handlebars/Thymeleaf template body"]
  output_format           varchar(10) [not null, default: "PDF", note: "PDF | HTML"]
  version_history         jsonb       [not null, default: "[]", note: "[{version_number, content, output_format, published_by, published_at}]"]
  is_active               boolean     [not null, default: true]
  published_by            uuid
  published_at            timestamptz
  created_at              timestamptz [not null, default: `now()`]
  updated_at              timestamptz [not null, default: `now()`]
}

Table ins_document.generated_documents {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  document_reference  varchar(30) [unique, not null]
  template_id         uuid        [not null, ref: > ins_document.document_templates.id]
  template_version    int         [not null, default: 1]
  entity_type         varchar(30) [not null, note: "POLICY | CLAIM | QUOTE | PAYMENT"]
  entity_id           uuid        [not null]
  entity_reference    varchar(30) [note: "Human-readable: policy number, claim reference"]
  customer_id         uuid        [note: "Enables customer portal to list 'my documents'"]
  document_name       varchar(200)[not null]
  storage_key         varchar(500)[not null, note: "S3/MinIO object key"]
  file_size_bytes     bigint
  mime_type           varchar(60) [not null, default: "application/pdf"]
  generated_by        uuid
  generation_context  jsonb       [note: "Template variables used at generation time"]
  is_latest_version   boolean     [not null, default: true]
  superseded_by       uuid        [note: "Points to newer generated_documents.id if re-issued"]
  created_at          timestamptz [not null, default: `now()`]
}

// ─── ins_notification ─────────────────────────────────────

Table ins_notification.notifications {
  id                  uuid        [pk, default: `gen_random_uuid()`]
  notification_ref    varchar(30) [unique, not null]
  event_code          varchar(80) [not null, note: "POLICY_ACTIVE | POLICY_FORWARDED | CLAIM_SUBMITTED | CLAIM_APPROVED | FIELD_ASSIGNED | PREMIUM_RECEIVED | RENEWAL_REMINDER | ..."]
  title               varchar(200)[not null]
  body                text        [not null]
  target_role         varchar(50) [not null, note: "ROLE_CUSTOMER | ROLE_AGENT | ROLE_UNDERWRITER | ROLE_CLAIMS_OFFICER | ROLE_FIELD_OFFICER | ROLE_FINANCE | ROLE_RELATIONSHIP_MANAGER"]
  target_user_id      uuid        [note: "Set for user-specific notifications; overrides role broadcast"]
  target_user_email   varchar(150)[note: "Denormalized for email routing"]
  entity_type         varchar(30) [note: "POLICY | CLAIM | UW_CASE | FIELD_INVESTIGATION | PAYMENT"]
  entity_id           uuid
  entity_reference    varchar(30)
  priority            varchar(10) [not null, default: "NORMAL", note: "LOW | NORMAL | HIGH | URGENT"]
  delivery_channel    varchar(10) [not null, default: "IN_APP", note: "IN_APP | EMAIL | SMS"]
  delivery_status     varchar(15) [not null, default: "PENDING", note: "PENDING | SENT | DELIVERED | FAILED"]
  delivered_at        timestamptz
  failure_reason      text
  is_read             boolean     [not null, default: false]
  read_at             timestamptz
  created_at          timestamptz [not null, default: `now()`]
}

// ─── ins_audit ────────────────────────────────────────────

Table ins_audit.audit_logs {
  id              bigint      [pk, increment, note: "GENERATED ALWAYS AS IDENTITY — sequential for strict temporal order"]
  event_time      timestamptz [not null, default: `now()`]
  request_id      varchar(64) [note: "Distributed trace / correlation ID"]
  service_name    varchar(60) [not null, note: "auth-service | policy-service | claims-service | underwriting-service | field-service | document-service | notification-service | rule-engine-service"]
  action          varchar(80) [not null, note: "USER_LOGIN | POLICY_CREATED | POLICY_STATUS_CHANGED | POLICY_FORWARDED | POLICY_APPROVED | CLAIM_SUBMITTED | UW_CASE_OPENED | UW_DECISION | UW_FORWARDED_TO_FIELD | FIELD_ASSIGNED | PAYMENT_PROCESSED | RULE_PUBLISHED | PLAN_PUBLISHED | PROFILE_UPDATE_REQUESTED | RULE_EVALUATED | ..."]
  actor_user_id   uuid
  actor_username  varchar(100)
  actor_role      varchar(60)
  actor_ip        inet
  entity_type     varchar(60) [note: "USER | POLICY | CLAIM | UW_CASE | FIELD_INVESTIGATION | RULE | PAYMENT | PLAN | PRODUCT | DOCUMENT"]
  entity_id       varchar(36)
  entity_reference varchar(60)
  old_values      jsonb       [note: "State before change (UPDATE/DELETE events)"]
  new_values      jsonb       [note: "State after change (INSERT/UPDATE events)"]
  result          varchar(10) [not null, default: "SUCCESS", note: "SUCCESS | FAILURE | PARTIAL"]
  failure_reason  text
  metadata        jsonb       [note: "HTTP method, endpoint, user-agent, etc."]

  Note: "Append-only. RLS policy prevents UPDATE/DELETE even for the service role."
}

// ─── ins_workflow ─────────────────────────────────────────

Table ins_workflow.platform_configurations {
  id            uuid        [pk, default: `gen_random_uuid()`]
  config_key    varchar(150)[unique, not null, note: "Dot-notation: pricing.gst_rate | risk_routing.bands | sla.claims.by_priority"]
  config_value  text        [not null]
  value_type    varchar(10) [not null, default: "STRING", note: "STRING | NUMBER | BOOLEAN | JSON"]
  description   varchar(400)
  group_name    varchar(30) [not null, default: "GENERAL", note: "PRICING | RISK_ROUTING | RISK_MULTIPLIER | SLA | WORKFLOW | ZONES | PRODUCT_FORMS | CLAIMS | NOTIFICATIONS | SECURITY | GENERAL"]
  is_active     boolean     [not null, default: true]
  updated_by    uuid
  created_at    timestamptz [not null, default: `now()`]
  updated_at    timestamptz [not null, default: `now()`]

  Note: "Single config store absorbing all removed config tables. Underwriter manages via portal."
}
